{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:api": "bun src/main.api.ts",
    "start:worker": "bun src/main.worker.ts",
    "bootstrap": "bun src/main.bootstrap.ts",
    "demo:send-message": "bun src/cli/send-demo-message.ts",
    "dlq": "bun src/cli/dead-letters.ts",
    "reconcile": "bun src/cli/reconcile-wallets.ts",
    "migrate:up": "bun src/platform/database/migrate.ts up",
    "migrate:down": "bun src/platform/database/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "bun test --timeout 60000 test/unit test/integration test/concurrency",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test:concurrency": "bun test --timeout 60000 test/concurrency",
    "test:spike": "bun test --timeout 60000 test/spike",
    "test:load": "bun test/load/run.ts",
    "test:e2e": "bun test --timeout 60000 test/e2e",
    "infra:up": "docker compose up -d --wait postgres sqs",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1145.0",
    "@mikro-orm/core": "7.2.3",
    "@mikro-orm/migrations": "7.2.3",
    "@mikro-orm/postgresql": "7.2.3",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "big.js": "7.0.1",
    "canonicalize": "5.1.0",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@types/big.js": "7.0.0",
    "@types/bun": "1.3.14",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
