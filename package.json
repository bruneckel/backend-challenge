{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:api": "bun src/main.api.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test --timeout 30000 test/unit test/integration",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test:spike": "bun test --timeout 60000 test/spike",
    "infra:up": "docker compose up -d --wait postgres sqs",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1145.0",
    "@mikro-orm/core": "7.2.3",
    "@mikro-orm/migrations": "7.2.3",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.3",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@types/bun": "1.3.14",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
